# Paste ONE LLM key. The provider is detected from it:
#   sk-ant-...  -> Anthropic (default model claude-haiku-4-5)
#   other key   -> OpenAI    (default model gpt-4.1-mini)
LLM_API_KEY=

# Optional overrides
# LLM_PROVIDER: anthropic or openai (only needed if detection guesses wrong)
LLM_PROVIDER=
# LLM_MODEL: any model with structured-output (JSON schema) support
LLM_MODEL=
# LLM_BASE_URL: OpenAI-compatible server, e.g. http://localhost:11434/v1 (Ollama) or https://openrouter.ai/api/v1
LLM_BASE_URL=
# USD per 1M tokens, only for models not listed in src/cost.py
LLM_PRICE_IN=
LLM_PRICE_OUT=

# Optional: Serper (https://serper.dev) key, only needed for name inputs ("charity: water")
SEARCH_API_KEY=
